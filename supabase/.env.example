# Copy to supabase/.env for local testing, or set these as Supabase secrets.
# NEVER put these in config.js or commit them to GitHub.

# --- Brain: the first key that's set wins (Gemini -> OpenAI -> xAI) ---
# Google Gemini: FREE tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma list tried in order when a model is busy (503/429/5xx).
# Default: gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest,gemma-4-31b-it
GEMINI_MODELS=
# Optional: total time for the whole chain, in ms (default 12000)
GEMINI_BUDGET_MS=
# Optional: low (default, fastest), medium, or high
GEMINI_THINKING_LEVEL=
# Optional: defaults to https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=

# Paid fallbacks (only used when GEMINI_API_KEY is empty)
OPENAI_API_KEY=
XAI_API_KEY=
# Optional overrides for the OpenAI/xAI path
LLM_BASE_URL=
LLM_MODEL=

# --- Jimmy's cloned voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
